		"@types/node": "26.6.2",
		"@types/react": "19.3.0",
		"create-typescript-app": "2.87.23",
		"cspell": "10.5.2",
		"eslint": "10.15.0",
		"eslint-plugin-jsdoc": "65.5.0",
		"eslint-plugin-jsonc": "3.4.1",
