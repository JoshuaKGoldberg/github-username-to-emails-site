{
	"compilerOptions": {
		"allowImportingTsExtensions": true,
		"declaration": true,
		"esModuleInterop": true,
		"jsx": "react-jsx",
		"module": "NodeNext",
		"moduleResolution": "NodeNext",
		"noEmit": true,
		"resolveJsonModule": true,
		"rewriteRelativeImportExtensions": true,
		"skipLibCheck": true,
		"strict": true,
		"target": "ES2022"
	},
	"include": ["app", "remix.env.d.ts", "src"]
}
